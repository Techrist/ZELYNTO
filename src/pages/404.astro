---
import { SITE_URL } from "../routing";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#5b63d9" />
    <title>Page not found — Zelynto</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`${SITE_URL}/404`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />
    <style>
      :root { color-scheme: light dark; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-content: center;
        gap: 14px;
        padding: 24px;
        text-align: center;
        font-family: "Google Sans", ui-sans-serif, system-ui, sans-serif;
        background: #f6f7fb;
        color: #101422;
      }
      h1 { font-size: clamp(32px, 6vw, 56px); margin: 0; }
      p { color: #5c6678; margin: 0; }
      a {
        margin-top: 10px;
        display: inline-block;
        padding: 12px 22px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        font-weight: 900;
        background: linear-gradient(135deg, #31b7e8, #5b63d9 48%, #a43da0);
      }
      @media (prefers-color-scheme: dark) {
        body { background: #0e1016; color: #f2f4f8; }
        p { color: #9aa3b3; }
      }
    </style>
  </head>
  <body>
    <h1>404</h1>
    <p>This page doesn't exist.</p>
    <a href="/">Back to Zelynto</a>
  </body>
</html>
